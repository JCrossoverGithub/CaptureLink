{
  "name": "capturelink",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first Xbox Remote Play desktop client focused on local viewing, listening, controls, diagnostics, and recording.",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis",
    "vendor:xbox-player": "node scripts/vendor-xbox-player.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.capturelink.desktop",
    "productName": "CaptureLink",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "xal-node": "^1.1.5"
  }
}
