{
  "name": "capturelink",
  "version": "0.2.0",
  "private": true,
  "description": "Windows-first Xbox Remote Play desktop client focused on local viewing, listening, controls, diagnostics, and recording.",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis",
    "vendor:xbox-player": "node scripts/vendor-xbox-player.mjs",
    "predev": "npm run vendor:xbox-player",
    "prebuild": "npm run vendor:xbox-player"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "ffmpeg-static": "5.3.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.capturelink.desktop",
    "productName": "CaptureLink",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "CaptureLink",
      "icon": "build/CaptureLink.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CaptureLink-Setup-${version}.${ext}",
      "shortcutName": "CaptureLink",
      "uninstallDisplayName": "CaptureLink",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/CaptureLink.ico",
      "uninstallerIcon": "build/CaptureLink.ico",
      "installerHeaderIcon": "build/CaptureLink.ico"
    },
    "extraResources": [
      {
        "from": "build/CaptureLink.ico",
        "to": "CaptureLink.ico"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "third_party/licenses",
        "to": "licenses"
      },
      {
        "from": "third_party/xbox-xcloud-player/SOURCE.json",
        "to": "licenses/xbox-xcloud-player/SOURCE.json"
      },
      {
        "from": "third_party/xbox-xcloud-player/UPSTREAM_PACKAGE.json",
        "to": "licenses/xbox-xcloud-player/UPSTREAM_PACKAGE.json"
      },
      {
        "from": "third_party/xbox-xcloud-player/README.md",
        "to": "licenses/xbox-xcloud-player/README.md"
      }
    ]
  },
  "dependencies": {
    "xal-node": "^1.1.5"
  },
  "author": "Josh Schultz",
  "homepage": "https://github.com/JCrossoverGithub/CaptureLink",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCrossoverGithub/CaptureLink.git"
  }
}
